# ─── フロント（クライアント公開） ───────────────────────────────
# バックエンド切替。縦スライス検証は "db"。既存GAS運用は "gas"（既定）。
NEXT_PUBLIC_BACKEND=db
# GAS 運用時のみ必要（db では不要）
NEXT_PUBLIC_GAS_ENDPOINT=YOUR_GAS_WEB_APP_URL_HERE
NEXT_PUBLIC_LIFF_ID=YOUR_LIFF_ID

# ─── サーバー（Route Handlers） ─────────────────────────────────
# 非特権ロール app_couple での接続（RLS を必ず通す）。ローカルは supabase の db ポート(54322)。
# 例: postgres://app_couple:devpassword@127.0.0.1:54322/postgres
DATABASE_URL_APP_COUPLE=postgres://app_couple:devpassword@127.0.0.1:54322/postgres
# LINE Developers の「LINE Login」チャネル ID（ID Token の aud 検証に使用）
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
# セッション Cookie 署名鍵（32byte 以上）。例: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-32byte-or-longer-random-secret
# dev 専用 ID Token バイパス（本番では必ず false）。true のとき id_token="dev:Udev123" で入れる。
ALLOW_DEV_LINE_BYPASS=true
