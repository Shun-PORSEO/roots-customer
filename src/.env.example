# ─── フロント（クライアント公開） ───────────────────────────────
# バックエンド。既定は "db"（Supabase + Route Handlers）。GAS 経路は C5 で廃止した。
# "mock" にするとネットワーク無しの UI 開発用モックデータを使う。
NEXT_PUBLIC_BACKEND=db
NEXT_PUBLIC_LIFF_ID=YOUR_LIFF_ID

# ─── サーバー（Route Handlers） ─────────────────────────────────
# 非特権ロール app_couple での接続（RLS を必ず通す）。ローカルは supabase の db ポート(54322)。
# 例: postgres://app_couple:devpassword@127.0.0.1:54322/postgres
DATABASE_URL_APP_COUPLE=postgres://app_couple:devpassword@127.0.0.1:54322/postgres
# LINE Login チャネル ID のフォールバック（任意・SaaS化 C2 以降）。
# 正は venue 別の venues.line_login_channel_id（管理画面の式場設定）。
# venue を特定できないリクエストの後方互換用にのみ使われる。
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
# セッション Cookie 署名鍵（32byte 以上）。例: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-32byte-or-longer-random-secret
# dev 専用 ID Token バイパス（本番では必ず false）。true のとき id_token="dev:Udev123" で入れる。
ALLOW_DEV_LINE_BYPASS=true

# ─── テナント管理者認証（Supabase Auth・SaaS化 C1） ──────────────────
# ローカルは supabase status の API URL / anon key。未設定でもカップル経路は動く。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Stripe 課金（SaaS化 C4） ───────────────────────────────────────
# 3点セットで有効化される。未設定の環境では Checkout/Portal を出さず、
# オンボーディング完了時に14日のローカルトライアル行を作って動作する。
#   STRIPE_SECRET_KEY     : Stripe ダッシュボード → 開発者 → API キー（sk_test_...）
#   STRIPE_WEBHOOK_SECRET : stripe listen / Webhook エンドポイントの signing secret（whsec_...）
#   STRIPE_PRICE_ID       : 月額9,800円プランの Price ID（price_...）
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
STRIPE_PRICE_ID=price_YOUR_PRICE_ID

# ─── Vercel Cron（SaaS化 C5） ───────────────────────────────────────
# 毎朝9:00 JST のリマインド送信 API の Bearer 認証シークレット（任意の長い文字列）。
# 手動実行: curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/reminders
CRON_SECRET=change-me-to-a-long-random-string

# ─── AI メッセージ生成（SaaS化 C5） ─────────────────────────────────
# 運営者の Claude API キーで全テナント共通提供する（テナントは自前のキー不要）。
# 未設定なら管理画面の「AIで下書き」は使用不可のエラーを返すだけ（他機能に影響なし）。
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
# 生成モデルとテナント別の1日あたり生成回数上限（ai_usage で計数）
AI_MODEL=claude-haiku-4-5
AI_DAILY_LIMIT=50
